{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "factchat-claude": {
      "npm": "@ai-sdk/anthropic",
      "name": "BAZE (Claude)",
      "options": {
        "baseURL": "https://factchat-cloud.mindlogic.ai/v1/gateway/claude/v1",
        "apiKey": "{env:BAZE_API_KEY}"
      },
      "models": {
        "claude-opus-5": {
          "name": "Claude Opus 5",
          "limit": { "context": 1000000, "output": 32000 }
        },
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "limit": { "context": 1000000, "output": 32000 }
        },
        "claude-fable-5-1": {
          "name": "Claude Fable 5.1",
          "limit": { "context": 1000000, "output": 32000 }
        }
      }
    },
    "factchat-openai": {
      "npm": "@ai-sdk/openai",
      "name": "BAZE (GPT)",
      "options": {
        "baseURL": "https://factchat-cloud.mindlogic.ai/v1/gateway",
        "apiKey": "{env:BAZE_API_KEY}"
      },
      "models": {
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "limit": { "context": 1050000, "output": 32768 }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "limit": { "context": 1050000, "output": 32768 }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "limit": { "context": 1050000, "output": 32768 }
        }
      }
    },
    "factchat": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "BAZE",
      "options": {
        "baseURL": "https://factchat-cloud.mindlogic.ai/v1/gateway",
        "apiKey": "{env:BAZE_API_KEY}"
      },
      "models": {
        "grok-4.6": {
          "name": "Grok 4.6",
          "limit": { "context": 500000, "output": 32768 }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": { "context": 1000000, "output": 32768 }
        }
      }
    }
  },
  "model": "factchat-claude/claude-sonnet-5"
}
